// Prisma schema for BugTrack AI
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         String          @default("DEVELOPER") // ADMIN, TESTER, DEVELOPER
  skills       String          @default("General")
  createdAt    DateTime        @default(now())

  ownedProjects   Project[]       @relation("ProjectOwner")
  projectMembers  ProjectMember[]
  reportedIssues  Issue[]         @relation("ReportedIssues")
  assignedIssues  Issue[]         @relation("AssignedIssues")
  comments        Comment[]
  activities      Activity[]
  verifications   Verification[]
}

model Project {
  id               String          @id @default(cuid())
  name             String
  description      String?
  ownerId          String
  githubRepository String?
  createdAt        DateTime        @default(now())

  owner            User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  issues           Issue[]

  @@index([ownerId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("DEVELOPER") // ADMIN, TESTER, DEVELOPER

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Issue {
  id               String         @id @default(cuid())
  issueKey         String         @unique
  projectId        String
  title            String
  description      String
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  environment      String?        @default("Production / Web")
  severity         String         @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  priority         String         @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status           String         @default("OPEN")   // OPEN, ASSIGNED, IN_PROGRESS, READY_FOR_TESTING, REOPENED, CLOSED
  reporterId       String
  assigneeId       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter         User           @relation("ReportedIssues", fields: [reporterId], references: [id])
  assignee         User?          @relation("AssignedIssues", fields: [assigneeId], references: [id])
  comments         Comment[]
  activities       Activity[]
  pullRequests     PullRequest[]
  verifications    Verification[]

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@index([reporterId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  message   String
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([userId])
}

model Activity {
  id        String   @id @default(cuid())
  issueId   String
  userId    String?
  action    String   // CREATED, STATUS_CHANGE, ASSIGNED, PR_LINKED, VERIFIED, COMMENTED
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([issueId])
}

model PullRequest {
  id          String   @id @default(cuid())
  issueId     String
  repository  String
  prNumber    Int
  title       String
  url         String
  state       String   @default("open")
  changedFiles String  @default("[]") // JSON string of changed files
  aiSummary   String?
  riskNotes   String?  // JSON string of AI risk analysis report
  createdAt   DateTime @default(now())

  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Verification {
  id        String   @id @default(cuid())
  issueId   String
  testerId  String
  result    String   // PASSED, FAILED
  testNotes String?
  testedAt  DateTime @default(now())

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  tester    User     @relation(fields: [testerId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([testerId])
}
